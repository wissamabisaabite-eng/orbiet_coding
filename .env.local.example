# Firebase Web SDK config for the Orbiet learner site.
# Copy this file to `.env.local` and fill in the values from your
# Firebase console: Project settings -> General -> Your apps -> Web app.
#
# These are public by design (client-side reads are allowed under the current
# firestore.rules). Never put Admin SDK / service-account secrets here.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Adsterra ad-unit keys (Adsterra dashboard -> your ad unit -> "key" value
# inside the atOptions snippet). Leave blank to show a placeholder instead.
NEXT_PUBLIC_ADSTERRA_KEY_LEADERBOARD=
NEXT_PUBLIC_ADSTERRA_KEY_MOBILE=
NEXT_PUBLIC_ADSTERRA_KEY_SIDEBAR=
# Adsterra "Video" ad-unit key -- THIS is the fallback banner shown inside
# VideoAdModal whenever the HilltopAds video ad below fails/has no fill.
# Without this, the fallback silently renders nothing but placeholder text.
NEXT_PUBLIC_ADSTERRA_KEY_VIDEO=

# HilltopAds VAST tag URL (HilltopAds dashboard -> your "In-Page Push" /
# "VAST" video ad zone -> copy the VAST tag URL). Required for the video ad
# gate between lessons to show a real HilltopAds video at all -- without it,
# VideoAdModal skips straight to the Adsterra fallback banner above every
# single time (see the runPrefetchPipeline() check in VideoAdModal.tsx).
NEXT_PUBLIC_HILLTOP_VAST_TAG_URL=